# Copy this file to  ~/hanks-secrets/hanks.env  (OUTSIDE the project folder) and
# fill in real values. On Windows that is  C:\Users\<you>\hanks-secrets\hanks.env
# (Local-dev fallback: backend/.env -- but never upload or share that file.)

# PostgreSQL connection. Create the database first:
#   createdb hanks_bbq   (or: CREATE DATABASE hanks_bbq; in psql)
DATABASE_URL=postgresql+psycopg2://hanks_user:PUT-A-STRONG-DB-PASSWORD-HERE@localhost:5432/hanks_bbq

# REQUIRED. Secret used to sign login tokens. The app will NOT start if this is
# missing, short (<32 chars), a placeholder, or a previously leaked secret.
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Port the API (and the website it serves) listens on. The UI's js/api.js expects 8000.
APP_PORT=8000

# Leave EMPTY: the app serves the website itself, so only same-origin is needed.
# Only if another website must call the API, list it, e.g. https://yourdomain.com
# ("*" is rejected and the app will not start.)
CORS_ORIGINS=

# /docs and /openapi.json are hidden. Set to true ONLY on your own computer.
DOCS_ENABLED=false
